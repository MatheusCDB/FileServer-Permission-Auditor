                            <td>$($Member.MemberName)</td>
                            <td>$($Member.MemberSamAccountName)</td>
                            <td>$ObjectClassBadge</td>
                        </tr>
"@
        }
    }

    $Html += @"
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="footer">
            <p>Relatório gerado automaticamente por PowerShell Dashboard | $(Get-Date -Format 'dd/MM/yyyy HH:mm:ss')</p>
            <p style="font-size: 10px; color: #a0aec0;">⚠️ Contas de sistema e administradores foram filtradas automaticamente</p>
        </div>
    </div>
    
    <script>
        function filterTables() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            const filterType = document.getElementById('filterType').value;
            const folderFilter = document.getElementById('folderFilter').value;
            
            // Filtra tabela de permissões
            const permissionRows = document.querySelectorAll('.permission-row');
            permissionRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const folderMatch = folderFilter === 'all' || row.dataset.folder === folderFilter;
                const show = text.includes(searchText) && 
                            (filterType === 'all' || filterType === 'permission') && 
                            folderMatch;
                row.style.display = show ? '' : 'none';
            });
            
            // Filtra tabela de grupos
            const groupRows = document.querySelectorAll('.group-row');
            groupRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const show = text.includes(searchText) && (filterType === 'all' || filterType === 'group');
                row.style.display = show ? '' : 'none';
            });
        }
    </script>
</body>
</html>
"@

    return $Html
}

# ==============================================
# EXECUÇÃO PRINCIPAL
# ==============================================

Clear-Host
Write-Host "╔════════════════════════════════════════════════════════════╗" -ForegroundColor Cyan
Write-Host "║        📊 DASHBOARD DE AUDITORIA DE PERMISSÕES           ║" -ForegroundColor Cyan
Write-Host "╚════════════════════════════════════════════════════════════╝" -ForegroundColor Cyan
Write-Host ""

Write-Host "📁 Pasta a ser auditada: $FolderPathToAudit" -ForegroundColor Yellow
Write-Host "📂 Arquivo de saída: $OutputPath" -ForegroundColor Yellow
Write-Host "🏢 OU Base: $ADSearchBase" -ForegroundColor Yellow
Write-Host ""

# Verifica se o módulo AD está disponível
try {
    $ADModule = Get-Module -ListAvailable -Name ActiveDirectory
    if (-not $ADModule) {
        Write-Warning "Módulo ActiveDirectory não encontrado. Instale o RSAT-AD-PowerShell."
        Write-Host "ℹ️  Execute como Administrador: Install-WindowsFeature RSAT-AD-PowerShell" -ForegroundColor Yellow
    } else {
        # Importa o módulo AD
        Import-Module ActiveDirectory -ErrorAction SilentlyContinue
        Write-Host "✅ Módulo ActiveDirectory carregado" -ForegroundColor Green
    }
} catch {
    Write-Warning "Não foi possível verificar o módulo AD"
}

Write-Host ""
Write-Host "⏳ Coletando permissões das pastas..." -ForegroundColor Yellow

# Obtém permissões das pastas
$FolderPermissions = Get-FolderPermissions -FolderPath $FolderPathToAudit

Write-Host "✅ Permissões coletadas: $($FolderPermissions.Count)" -ForegroundColor Green
Write-Host ""
Write-Host "⏳ Coletando membros dos grupos AD..." -ForegroundColor Yellow

# Obtém membros dos grupos
$GroupMembers = Get-ADGroupMembers -SearchBase $ADSearchBase -GroupFilter $ADGroupFilter

Write-Host "✅ Membros coletados: $($GroupMembers.Count)" -ForegroundColor Green
Write-Host ""
Write-Host "⏳ Gerando dashboard HTML..." -ForegroundColor Yellow

# Gera o HTML
$HtmlContent = Generate-HtmlDashboard -FolderPermissions $FolderPermissions -GroupMembers $GroupMembers -FolderPath $FolderPathToAudit -ADSearchBase $ADSearchBase

# Salva o HTML
try {
    $HtmlContent | Out-File -FilePath $OutputPath -Encoding UTF8 -Force
    Write-Host "✅ Dashboard gerado com sucesso!" -ForegroundColor Green
    Write-Host "📁 Arquivo: $OutputPath" -ForegroundColor Cyan
} catch {
    Write-Error "Erro ao salvar o arquivo: $_"
    Write-Host "Tentando salvar no diretório atual..." -ForegroundColor Yellow
    $OutputPath = ".\Dashboard_Permissoes.html"
    $HtmlContent | Out-File -FilePath $OutputPath -Encoding UTF8 -Force
    Write-Host "✅ Arquivo salvo em: $OutputPath" -ForegroundColor Green
}

# Abre automaticamente no navegador
try {
    Start-Process $OutputPath
    Write-Host "🌐 Abrindo dashboard no navegador..." -ForegroundColor Yellow
}
catch {
    Write-Host "⚠️ Não foi possível abrir o navegador automaticamente." -ForegroundColor Yellow
    Write-Host "📂 Abra manualmente o arquivo: $OutputPath" -ForegroundColor Yellow
}

Write-Host ""
Write-Host "╔════════════════════════════════════════════════════════════╗" -ForegroundColor Green
Write-Host "║           ✨ AUDITORIA CONCLUÍDA COM SUCESSO!            ║" -ForegroundColor Green
Write-Host "╚════════════════════════════════════════════════════════════╝" -ForegroundColor Green
Write-Host ""
Write-Host "📋 Resumo:" -ForegroundColor Cyan
Write-Host "   • Pastas auditadas: $(($FolderPermissions | Select-Object FolderPath -Unique).Count)" -ForegroundColor White
Write-Host "   • Permissões encontradas: $($FolderPermissions.Count)" -ForegroundColor White
Write-Host "   • Grupos na OU: $(($GroupMembers | Select-Object GroupName -Unique).Count)" -ForegroundColor White
Write-Host "   • Membros coletados: $($GroupMembers.Count)" -ForegroundColor White
Write-Host ""
