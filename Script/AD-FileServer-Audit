            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .container {
            animation: fadeIn 0.5s ease-out;
        }
        
        .stat-card {
            animation: fadeIn 0.5s ease-out;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📊 Dashboard de Auditoria de Permissões</h1>
            <p class="subtitle">Pasta auditada: <strong>$FolderPath</strong> | OU: <strong>$ADSearchBase</strong> | Gerado em: $(Get-Date -Format 'dd/MM/yyyy HH:mm:ss')</p>
        </div>
        
        <div class="stats">
            <div class="stat-card">
                <div class="number">$TotalPermissions</div>
                <div class="label">Total de Permissões</div>
            </div>
            <div class="stat-card">
                <div class="number">$UniqueFolders</div>
                <div class="label">Pastas Auditadas</div>
            </div>
            <div class="stat-card">
                <div class="number">$UniqueUsers</div>
                <div class="label">Usuários Únicos</div>
            </div>
            <div class="stat-card">
                <div class="number">$UniqueGroups</div>
                <div class="label">Grupos AD</div>
            </div>
        </div>
        
        <div class="controls">
            <input type="text" id="searchInput" placeholder="🔍 Buscar por pasta, usuário ou grupo..." onkeyup="filterTables()">
            <select id="filterType" onchange="filterTables()">
                <option value="all">Todos os Tipos</option>
                <option value="permission">Permissões</option>
                <option value="group">Grupos</option>
            </select>
            <select id="folderFilter" onchange="filterTables()">
                <option value="all">Todas as Pastas</option>
                $FolderOptions
            </select>
        </div>
        
        <div class="section">
            <h2 class="section-title">📁 Permissões de Pastas</h2>
            <div class="table-container">
                <table id="permissionsTable">
                    <thead>
                        <tr>
                            <th>Pasta</th>
                            <th>Grupo/Usuário</th>
                            <th>Permissão</th>
                            <th>Tipo</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
"@

    # Adiciona dados de permissões
    if ($FolderPermissions.Count -eq 0) {
        $Html += @"
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <div class="icon">📭</div>
                                    <p>Nenhuma permissão encontrada. Verifique o caminho da pasta.</p>
                                </div>
                            </td>
                        </tr>
"@
    } else {
        foreach ($Perm in $FolderPermissions) {
            $PermissionClass = ""
            if ($Perm.Permissions -match "FullControl") { $PermissionClass = "permission-full" }
            elseif ($Perm.Permissions -match "Modify") { $PermissionClass = "permission-modify" }
            elseif ($Perm.Permissions -match "Write") { $PermissionClass = "permission-write" }
            elseif ($Perm.Permissions -match "Read") { $PermissionClass = "permission-read" }
            
            $InheritedBadge = if ($Perm.IsInherited) { 
                '<span class="badge badge-warning">Herdada</span>' 
            } else { 
                '<span class="badge badge-success">Direta</span>' 
            }
            
            $AccessType = if ($Perm.AccessControlType -eq "Allow") {
                '<span class="badge badge-success">Permitir</span>'
            } else {
                '<span class="badge badge-danger">Negar</span>'
            }
            
            $Html += @"
                        <tr class="permission-row" data-type="permission" data-folder="$($Perm.FolderPath)">
                            <td><strong>$($Perm.FolderName)</strong><br><small style="color:#718096;">$($Perm.FolderPath)</small></td>
                            <td>$($Perm.GroupUser)</td>
                            <td class="$PermissionClass">$($Perm.Permissions)</td>
                            <td>$AccessType</td>
                            <td>$InheritedBadge</td>
                        </tr>
"@
        }
    }

    $Html += @"
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="section">
            <h2 class="section-title">👥 Membros dos Grupos AD</h2>
            <div class="table-container">
