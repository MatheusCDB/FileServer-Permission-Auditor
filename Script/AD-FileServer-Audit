# Script para Auditoria de Permissões de Pastas com Dashboard HTML
# Autor: Assistente PowerShell
# Data: 2026

# ==============================================
# CONFIGURAÇÕES - AJUSTE AQUI CONFORME SUA NECESSIDADE
# ==============================================
$FolderPathToAudit = "\\fileserver\Arquivos"  # ALTERE PARA O CAMINHO CORRETO (ex: D:\FileServer, C:\Pastas, etc.)
$OutputFolder = $env:USERPROFILE + "\Documents"  # Salva em pasta Documentos do usuário
$OutputFileName = "Dashboard_Permissoes.html"
$OutputPath = Join-Path $OutputFolder $OutputFileName

# Configuração do Active Directory
$ADSearchBase = "OU=DOMAIN,DC=DOMAIN,DC=local"
$ADGroupFilter = "*"  # Filtro para grupos (ex: "FileServer_*" para grupos que começam com FileServer)

# Lista de grupos/usuários a serem excluídos do relatório (case insensitive)
$ExcludedAccounts = @(
    "PROPRIETÁRIO CRIADOR",
    "CREATOR OWNER",
    "AUTORIDADE NT\SISTEMA",
    "NT AUTHORITY\SYSTEM",
    "BUILTIN\Administradores",
    "BUILTIN\ADMINISTRATORS",
    "ADMINS. DO DOMÍNIO",
    "DOMAIN ADMINS",
    "DOMINIO DA EMPRESA\ADMINS. DO DOMÍNIO",
    "DOMINIO DA EMPRESA\ADMINISTRADOR",
    "NT AUTHORITY\Authenticated Users",
    "USUÁRIOS AUTENTICADOS",
    "Everyone",
    "Todos"
)

# ==============================================
# FUNÇÃO PARA VERIFICAR SE DEVE EXCLUIR
# ==============================================
function Should-Exclude {
    param(
        [string]$AccountName
    )
    
    if ([string]::IsNullOrEmpty($AccountName)) {
        return $true
    }
    
    foreach ($Excluded in $ExcludedAccounts) {
        if ($AccountName -like "*$Excluded*" -or $AccountName -eq $Excluded) {
            return $true
        }
    }
    return $false
}

# ==============================================
# FUNÇÃO PARA OBTER PERMISSÕES DE PASTAS
# ==============================================
function Get-FolderPermissions {
    param(
        [string]$FolderPath
    )
    
    $FolderPermissions = @()
    
    # Verifica se o diretório existe
    if (-not (Test-Path $FolderPath)) {
        Write-Warning "Diretório $FolderPath não encontrado!"
        Write-Host "ℹ️  Verifique o caminho e ajuste a variável `$FolderPathToAudit no script." -ForegroundColor Yellow
        return $FolderPermissions
    }
    
    Write-Host "📂 Auditando: $FolderPath" -ForegroundColor Cyan
    
    # Obtém todas as pastas do diretório
    $Folders = Get-ChildItem -Directory -Path $FolderPath -Force -ErrorAction SilentlyContinue
    
    if ($Folders.Count -eq 0) {
        Write-Warning "Nenhuma pasta encontrada em $FolderPath"
        return $FolderPermissions
    }
    
    $TotalFolders = $Folders.Count
    $Current = 0
    $ExcludedCount = 0
    
    foreach ($Folder in $Folders) {
        $Current++
        Write-Progress -Activity "Auditando pastas" -Status "Processando: $($Folder.Name)" -PercentComplete (($Current / $TotalFolders) * 100)
        
        try {
            $Acl = Get-Acl -Path $Folder.FullName -ErrorAction SilentlyContinue
            
            foreach ($Access in $Acl.Access) {
                $AccountName = $Access.IdentityReference.Value
                
                # Verifica se deve excluir esta conta
                if (Should-Exclude -AccountName $AccountName) {
                    $ExcludedCount++
                    continue
                }
                
                $FolderPermissions += [PSCustomObject]@{
                    FolderPath = $Folder.FullName
                    FolderName = $Folder.Name
                    GroupUser = $AccountName
                    Permissions = $Access.FileSystemRights
                    IsInherited = $Access.IsInherited
                    AccessControlType = $Access.AccessControlType
                }
            }
        }
        catch {
            Write-Warning "Erro ao acessar permissões de: $($Folder.FullName)"
        }
    }
    
    Write-Progress -Activity "Auditando pastas" -Completed
    Write-Host "ℹ️  $ExcludedCount entradas excluídas (sistema/administradores)" -ForegroundColor Yellow
    return $FolderPermissions
}

# ==============================================
# FUNÇÃO PARA OBTER MEMBROS DOS GRUPOS AD
# ==============================================
function Get-ADGroupMembers {
    param(
        [string]$SearchBase,
        [string]$GroupFilter = "*"
    )
    
    try {
        Write-Host "👥 Coletando grupos do Active Directory..." -ForegroundColor Cyan
        Write-Host "📁 OU Base: $SearchBase" -ForegroundColor Yellow
        
        $GroupMembers = @()
        
        # Obtém todos os grupos do AD na OU especificada
        $Groups = Get-ADGroup -Filter $GroupFilter -SearchBase $SearchBase -Properties Members -ErrorAction SilentlyContinue
        
        if ($Groups.Count -eq 0) {
            Write-Warning "Nenhum grupo encontrado na OU: $SearchBase"
            Write-Host "ℹ️  Verifique se o caminho da OU está correto" -ForegroundColor Yellow
            return $GroupMembers
        }
        
        Write-Host "ℹ️  Encontrados $($Groups.Count) grupos na OU" -ForegroundColor Green
        
        $TotalGroups = $Groups.Count
        $Current = 0
        $ExcludedCount = 0
        
        foreach ($Group in $Groups) {
            $Current++
            Write-Progress -Activity "Coletando membros dos grupos" -Status "Processando: $($Group.Name)" -PercentComplete (($Current / $TotalGroups) * 100)
            
            try {
                $Members = Get-ADGroupMember -Identity $Group.DistinguishedName -ErrorAction SilentlyContinue
                
                foreach ($Member in $Members) {
                    # Verifica se deve excluir este membro
                    if (Should-Exclude -AccountName $Member.Name) {
                        $ExcludedCount++
                        continue
                    }
                    
                    $GroupMembers += [PSCustomObject]@{
                        GroupName = $Group.Name
                        GroupDN = $Group.DistinguishedName
                        MemberName = $Member.Name
                        MemberSamAccountName = $Member.SamAccountName
                        MemberObjectClass = $Member.ObjectClass
                    }
                }
            }
            catch {
                # Pular grupos vazios ou com erro
            }
        }
        
        Write-Progress -Activity "Coletando membros dos grupos" -Completed
        Write-Host "ℹ️  $ExcludedCount membros excluídos (sistema/administradores)" -ForegroundColor Yellow
        return $GroupMembers
    }
    catch {
        Write-Warning "Erro ao acessar o Active Directory: $_"
        Write-Host "ℹ️  Verifique se o módulo AD está instalado e se você tem permissões" -ForegroundColor Yellow
        return @()
    }
}

# ==============================================
# FUNÇÃO PARA GERAR RELATÓRIO HTML
# ==============================================
